# Copy to .env and fill in. Do NOT commit the real .env.
# Admin login password for the web deployment.
UM_ADMIN_PASSWORD=change-me-to-something-strong
# Stable session secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
UM_SECRET_KEY=replace-with-64-hex-chars
# SMTP password for outbound email (the feedback form). Everything else
# about the mail server is set on the Settings page; only the password
# is read from here, so config.json on the data volume holds no secret.
UM_SMTP_PASSWORD=
